{% comment %}
This file contains the HTML for our two consent dialogs, which are hidden by default and shown as necessary.

Ideally, they should have `open` applied by an edge function (see apply-transformation.ts) to avoid any delay on rendering.
But I've included a client-side implementation in javascript-based-visibility.liquid too.

Note: the buttons below have `id` attributes not for functionality but to make them better labelled in RUM performance data.
{% endcomment %}
<dialog class="consent-dialog" id="consent-banner">
  <p>We use cookies, do you want cookies too?</p>

  <button type="button" command="show-modal" commandfor="consent-options" id="customise-btn">
    Customise choices
  </button>

  <button type="submit" form="consent-options-form" name="action" value="accept-all" id="accept-all-btn">
    Accept all the cookies!
  </button>
</dialog>

<dialog class="consent-dialog" id="consent-options">
  <p>What cookies do you want?</p>
  <form method="post" action="/consent" id="consent-options-form">
    <div>
      <label>
        <input type="checkbox" checked disabled>
        Required Cookies
      </label>
      <details>
        <summary>Details</summary>
        Detailed information about these cookies
      </details>
    </div>

    <div>
      <label>
        <cookie-based-checkbox>
          <input type="checkbox" name="consent-analytics" value="true" checked autofocus>
        </cookie-based-checkbox>
        Analytics Cookies
      </label>
      <details>
        <summary>Details</summary>
        Detailed information about these cookies
      </details>
    </div>

    <div>
      <label>
        <cookie-based-checkbox>
          <input type="checkbox" name="consent-marketing" value="true" checked>
        </cookie-based-checkbox>
        Marketing Cookies
      </label>
      <details>
        <summary>Details</summary>
        Detailed information about these cookies
      </details>
    </div>

    <footer>
      <button type="submit" name="action" value="reject-all" id="reject-all-btn">
        Reject all
      </button>

      <button type="submit" id="save-choices-btn">
        Save choices
      </button>
    </footer>
  </form>
</dialog>
