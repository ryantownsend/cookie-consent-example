<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="IE=edge" http-equiv="X-UA-Compatible" />
    <meta name="viewport" content="width=device-width,initial-scale=1.0,minimum-scale=1.0,user-scalable=yes" />
    <meta name="robots" content="noindex" />

    <title>Performant Cookie Consent Banner Example &ndash; Lessons of a CTO</title>

    <style>
      * {
        box-sizing: border-box;
      }

      body {
        font-family: system-ui, sans-serif;
        line-height: 1.5;
        padding: 1rem;
      }

      dialog {
        position: fixed;
        inset: auto 0 0;
        z-index: 1000;
        width: calc(100vw - 2rem);
        max-width: 500px;
        margin-inline: auto;

        border: 2px solid #000;
        border-bottom: 0;
        padding: 1rem;

        p {
          margin-block: 0 1lh;
        }
      }

      dialog::backdrop {
        background: rgba(0, 0, 0, 0.5);
      }

      #consent-options {
        div {
          display: grid;
          grid-template-columns: max-content auto;
          align-items: center;
          column-gap: 0.5rem;

          + div {
            margin-top: 0.5lh;
          }
        }
        label {
          display: contents;
        }
        label:not(label:has(input:disabled)),
        summary {
          cursor: pointer;
        }
        details {
          grid-column: 2;
          font-size: 0.8em;
        }
        footer { margin-top: 1rem }
      }

      cookie-based-checkbox {
        display: contents;
      }
    </style>
  </head>
  <body>
    <nav>
      <a href="/">Home</a>
      <a href="/ssr">SSR page</a>
      <a href="/change">Change consent choices</a>
    </nav>

    <h1>Performant Cookie Consent Banner Example</h1>
    <p>Read all about this approach on <a href="https://lessonsofacto.com/articles/006-taming-the-cookie-consent-monster/">Lessons of a CTO</a>. The heavily-commented code powering this is available open-source <a href="https://github.com/ryantownsend/cookie-consent-example">on GitHub</a>.</p>

    {{ content }}

    <!-- Attach Navigation API interception for consent form submissions -->
    {% include "javascript-form-intercept.liquid" %}

    <!-- Attach dialogs for consent choices -->
    {% include "dialogs.liquid" %}

    <!-- Load any scripts that should run after consent is given -->
    <script src="/scripts/post-consent.js" type="module" defer></script>

    {% unless page.url == "/ssr.html" %}
      <!-- Dynamically show the dialogs for non-SSR pages -->
      {% include "javascript-based-visibility" %}
      <!-- Repopulate checkbox values from the cookie -->
      <script src="/scripts/cookie-based-checkbox.js" type="module" defer></script>
    {% endunless %}
  </body>
</html>
